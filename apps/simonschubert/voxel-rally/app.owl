  let SECT = range(12).map(k => take(BOXES.filter(b => floor((atan2(b.z, b.x) + pi) / (2 * pi) * 12) % 12 == k), 120)).filter(bs => len(bs) > 0).map(bs => mesh(flatten(bs.map(b => CORN.map(c => [b.x + c[0] * b.w / 2, b.y + c[1] * b.h, b.z + c[2] * b.d / 2]))), flatten(bs.map((b, i) => drop(BF, b.nt == true ? 1 : 0).map(f => f.map(k => k + 8 * i)))), flatten(bs.map(b => b.nt == true ? [b.c, b.c, b.c, b.c] : [b.t, b.c, b.c, b.c, b.c]))))

  // Two rings round the world, overlapping so there's never a gap to the sky: near, mountains (or hills, or mesas)
