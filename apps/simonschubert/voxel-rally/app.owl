      {x: v[0] + 0.4 * v[2], y: 1.9 * v[2], z: v[1] + 0.3 * v[2], w: 0.4 * v[2], h: 0.08, d: 0.4 * v[2], c: #f8f4ea, t: #f8f4ea}
    ] : (v[3] == "cactus" ? [
