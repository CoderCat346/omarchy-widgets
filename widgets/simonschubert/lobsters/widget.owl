widget "lobsters" {
  meta { description: "The hottest stories on Lobsters with score, comments and tags; tap a story to read it"; version: "1.2"; license: "MIT"; category: "news"; owl: 16 }
  size: 6x4
  minSize: 4x3



  source feed = http("https://lobste.rs/hottest.json") every 15m json timeout 15s
  let hot = take(feed ?? [], 20).map(s => {
    id: s.short_id, title: s.title, score: s.score, comments: s.comment_count, tags: join(s.tags ?? [], " "),
    url: s.url == "" ? s.comments_url : s.url, discussion: s.comments_url
  })

  onTap: url("https://lobste.rs")

  Column {
    gap: 4
    Text { text: "lobsters"; style: muted; color: red }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for s in hot key s.id {
        Column {
          gap: 0
          onTap: url(s.url)
          Text { text: s.title; fontSize: 13; maxLines: 2 }
          Row {
            gap: 6
            Text { text: "${s.score} pts"; fontSize: 10; color: muted; width: 48 }
            Text { text: "${s.comments} comments"; fontSize: 10; color: muted; width: 88; onTap: url(s.discussion) }
            Text { text: s.tags; fontSize: 10; color: accent; maxLines: 1; weight: 1; align: end }
          }
        }
      }
    }
  }
}
