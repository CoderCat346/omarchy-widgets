widget "hacker news" {
  meta { description: "The Hacker News front page with points and comments; tap a story to read it"; version: "1.2"; license: "MIT"; category: "news"; owl: 16 }
  size: 6x4
  minSize: 4x3



  source feed = http("https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=15") every 15m json timeout 15s
  let hn = (feed.hits ?? []).map(h => {
    id: h.objectID, title: h.title, points: h.points, comments: h.num_comments ?? 0,
    url: h.url ?? "https://news.ycombinator.com/item?id=${h.objectID}",
    site: split(match(h.url ?? "", "^https?://(?:www[.])?([^/]*)")[0] ?? "", "/")[0]
  })

  onTap: url("https://news.ycombinator.com")

  Column {
    gap: 4
    Text { text: "hacker news"; style: muted; color: orange }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for s in hn key s.id {
        Column {
          gap: 0
          onTap: url(s.url)
          Text { text: s.title; fontSize: 13; maxLines: 2 }
          Row {
            gap: 6
            Text { text: "${s.points} pts"; fontSize: 10; color: muted; width: 56 }
            Text { text: "${s.comments} comments"; fontSize: 10; color: muted; width: 96; onTap: url("https://news.ycombinator.com/item?id=${s.id}") }
            Text { text: s.site; fontSize: 10; color: muted; maxLines: 1; weight: 1; align: end }
          }
        }
      }
    }
  }
}
