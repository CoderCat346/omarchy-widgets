widget "exchange rates" {
  meta { description: "Daily exchange rates from the European Central Bank with a 30-day trend; tap to pick the currencies"; version: "1.3"; license: "MIT"; category: "finance"; owl: 16 }
  size: 6x2
  minSize: 3x2

  // The first code is the base currency, the ones after are what it's quoted in.
  state codes = ["USD", "EUR", "GBP", "JPY"] persist
  // Up to 1.2 the list was ~/.config/omarchy-proot/exchange-rates, one code per line. When Linux is
  // there, that file is read once and taken over; without it, or once taken over, it isn't read again.
  state migrated = false persist
  source old = file("~/.config/omarchy-proot/exchange-rates") optional
  on old first {
    if !migrated {
      let found = lines(value).map(l => upper(trim(l))).filter(l => l != "" && !startsWith(l, "#"))
      if count(found) >= 2 { codes = found }
      migrated = true
    }
  }

  let base = codes[0]
  let to = drop(codes, 1)
  source now = clock every 1h
  source raw = http("https://api.frankfurter.dev/v1/${enc(fmtTime(now - 30 * 86400, "yyyy-MM-dd"))}..?base=${enc(base)}&symbols=${enc(join(to, ","))}") every 1h json timeout 15s
  // The days in order, then each currency's latest rate, its change from the day before and its 30 days.
  let days = entries(raw.rates ?? {}).sortBy(e => e.key).map(e => e.value)
  let fx = {
    base: raw.base,
    rates: count(days) < 2 ? [] : to.filter(c => get(last(days), c) != null).map(c => {
      code: c, rate: get(last(days), c), change: (get(last(days), c) / get(days[count(days) - 2], c) - 1) * 100,
      hist: days.map(d => get(d, c))
    })
  }

  onTap: screen()

  component Currency(c) {
    Column {
      weight: 1
      gap: 0
      Text { text: "${fx.base} → ${c.code}"; style: label; maxLines: 1 }
      Text { text: c.rate >= 100 ? fixed(c.rate, 1) : c.rate >= 10 ? fixed(c.rate, 2) : fixed(c.rate, 4); style: title; maxLines: 1 }
      Text { text: "${c.change >= 0 ? "+" : ""}${fixed(c.change, 2)}%"; style: small; color: c.change >= 0 ? green : red }
      Sparkline { values: c.hist; min: min(c.hist); max: max(c.hist); color: accent; fill: width; weight: 1 }
    }
  }

  // A tile taller than wide (the landscape home screen) stacks the currencies instead.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3

  if tall {
    Column {
      gap: 10
      for c in fx.rates key c.code {
        Currency { c: c }
      }
    }
  } else {
    Row {
      gap: 12
      for c in fx.rates key c.code {
        Currency { c: c }
      }
    }
  }

  screen {
    title: "exchange rates"
    Column {
      gap: 8
      Text { text: "currency codes, the base first"; style: label; color: muted }
      Input {
        text: join(codes, " ")
        placeholder: "USD EUR GBP JPY"
        onSubmit: {
          let next = split(upper(replace(value, ",", " ")), " ").map(c => trim(c)).filter(c => c != "")
          if count(next) >= 2 { codes = next }
        }
      }
      Text { text: "${base} in ${join(to, ", ")}"; style: small; color: muted }
      Button { text: "close"; onTap: close() }
    }
  }
}
