widget "ifsc" {
  meta {
    owl: 17
    description: "IFSC Climbing World Cup: the next event with a countdown, the latest podiums, live results and the cup standings for boulder, lead and speed. Tap for everything"
    version: "1.2"
    license: "MIT"
    category: "sport"
  }
  size: 6x4
  minSize: 3x3

  source now = clock every 1m

  // ifsc.results.info, straight from Android (it only wants a Referer). The API's root names the
  // current season, the season lists every event (the World Cups are league 1), the latest event
  // that has started lists its categories, and each category's results come on their own. Its
  // season-league endpoint now wants a login, so the calendar comes from the season itself.
  let api = "https://ifsc.results.info/api/v1"
  let hdr = {Referer: "https://ifsc.results.info/"}
  source root = http("https://ifsc.results.info/api/v1/", hdr) every 12h json timeout 15s
  source sea = http(root == null ? null : "${api}/seasons/${enc(root.current.id)}", hdr) every 10m json timeout 20s

  let season = root.current.season
  let league = last(split(root.current.leagues.find(l => l.league_id == 1).url ?? "", "/"))
  let wc = (sea.events ?? []).filter(e => str(e.league_season_id) == league)
  let events = wc.map(e => {
    id: e.event_id,
    name: match(e.event, "^(?:World Climbing Series |IFSC Climbing World Cup |IFSC World Cup |IFSC )?(.*?)(?: [0-9]{4})?$")[0] ?? e.event,
    full: e.event,
    start: parseTime(replace(replace(e.starts_at ?? "", " UTC", "Z"), " ", "T")),
    end: parseTime(replace(replace(e.ends_at ?? "", " UTC", "Z"), " ", "T")),
    dates: e.local_start_date == e.local_end_date ? fmtTime(parseTime(e.local_start_date), "d MMM")
      : "${fmtTime(parseTime(e.local_start_date), "d MMM")} – ${fmtTime(parseTime(e.local_end_date), "d MMM")}",
    kinds: unique((e.disciplines ?? []).map(d => d.kind).filter(k => !contains(k, "relay")))
  }).map(e => merge(e, {state: now >= e.end ? "done" : now >= e.start ? "live" : "next"})).sortBy(e => e.start)

  // The latest event that has started, its categories (relays left out), and the top 8 of each,
  // with each climber's score from the last round they climbed.
  let lat = last(events.filter(e => e.state != "next"))
  source ev = http(lat == null ? null : "${api}/events/${enc(lat.id)}", hdr) every 10m json timeout 20s
  let cats = ev.id == lat.id ? (ev.d_cats ?? []).filter(c => !contains(c.dcat_name ?? "", "RELAY")) : []
  source r0 = http(cats[0] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[0].dcat_id)}", hdr) every 10m json timeout 20s
  source r1 = http(cats[1] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[1].dcat_id)}", hdr) every 10m json timeout 20s
  source r2 = http(cats[2] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[2].dcat_id)}", hdr) every 10m json timeout 20s
  source r3 = http(cats[3] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[3].dcat_id)}", hdr) every 10m json timeout 20s
  source r4 = http(cats[4] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[4].dcat_id)}", hdr) every 10m json timeout 20s
  source r5 = http(cats[5] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[5].dcat_id)}", hdr) every 10m json timeout 20s
  // A slot whose category went away keeps its last value, so only this event's categories count.
  let results = [r0, r1, r2, r3, r4, r5].filter(r => r != null && r.event == lat.full && any(cats, c => c.dcat_name == r.dcat)).map(r => {
    name: r.dcat, short: "${lower(split(r.dcat, " ")[0])} ${sub(split(r.dcat, " ")[1] ?? "", 0, 1)}",
    kind: lower(split(r.dcat, " ")[0]), status: r.status,
    round: last((r.category_rounds ?? []).filter(x => x.status != null && x.status != "pending")).name,
    top: take(r.ranking ?? [], 8).map(a => {
      rank: a.rank, name: "${a.firstname} ${a.lastname}", country: a.country,
      score: split(str(last((a.rounds ?? []).filter(x => x.score != null && x.score != "")).score ?? ""), " (")[0]
    })
  }).filter(c => count(c.top) > 0)
  let finished = count(cats) > 0 && all(cats, c => c.status == "finished")
  let latest = lat == null ? null : merge(lat, {results: results, state: finished ? "done" : lat.state})

  // Cup standings, top 10 of each Olympic discipline.
  let cupId = first(wc.filter(e => e.cup_id != null)).cup_id
  source cupInfo = http(cupId == null ? null : "${api}/cups/${enc(cupId)}", hdr) every 12h json timeout 20s
  let cupCats = (cupInfo.d_cats ?? []).filter(c => match(c.name ?? "", "^(BOULDER|LEAD|SPEED) (Men|Women)$") != null)
  source c0 = http(cupCats[0] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[0].id)}", hdr) every 1h json timeout 20s
  source c1 = http(cupCats[1] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[1].id)}", hdr) every 1h json timeout 20s
  source c2 = http(cupCats[2] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[2].id)}", hdr) every 1h json timeout 20s
  source c3 = http(cupCats[3] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[3].id)}", hdr) every 1h json timeout 20s
  source c4 = http(cupCats[4] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[4].id)}", hdr) every 1h json timeout 20s
  source c5 = http(cupCats[5] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[5].id)}", hdr) every 1h json timeout 20s
  let standings = [c0, c1, c2, c3, c4, c5].filter(c => c != null && count(c.ranking ?? []) > 0).map(c => {
    name: c.dcat_name, short: "${lower(split(c.dcat_name, " ")[0])} ${sub(split(c.dcat_name, " ")[1] ?? "", 0, 1)}",
    kind: lower(split(c.dcat_name, " ")[0]),
    top: take(c.ranking, 10).map(a => {
      rank: a.rank, name: "${a.firstname} ${a.lastname}", country: a.country,
      score: num(a.score, null) != null && num(a.score, 0) == floor(num(a.score, 0)) ? str(floor(num(a.score, 0))) : a.score
    })
  }).sortBy(s => "${s.kind} ${contains(s.name, "Women") ? 1 : 0}")

  state tab = "results"
  state pick = 0

  let live = latest.state == "live"
  let upcoming = events.filter(e => e.state == "next")
  let next = first(upcoming)
  let wide = (tileWidth ?? 0) >= 300
  // Lines below the divider: the latest winners first, then cup leaders if 2+ fit.
  let slots = max(2, (rows ?? 4) * 2 - 1)
  let shown = results.take(slots)
  let spare = slots - count(shown) - 1
  let leaders = spare >= 2 ? standings.take(spare) : []


  component Until(t, tint = foreground, fs = 12) {
    Text {
      text: t - now > 86400 ? "in ${ceil((t - now) / 86400)}d" : t > now ? "in ${fmtDuration(t - now)}" : "now"
      fontSize: fs; width: 64; align: end; color: tint; maxLines: 1
    }
  }

  component Flag(code, px = 14) {
    if code {
      Image { src: "https://d1n1qj9geboqnb.cloudfront.net/flags/${enc(code)}.png"; width: px * 1.5; height: px; fit: contain }
    } else {
      Box { width: px * 1.5; height: px }
    }
  }

  component Kinds(list) {
    Row {
      gap: 4
      for k in list ?? [] {
        Text { text: k; style: label; width: len(k) * 7 + 14; align: center; color: (k == "boulder" ? yellow : k == "lead" ? blue : k == "speed" ? red : accent); padding: [5, 1]; border: 1; borderColor: alpha((k == "boulder" ? yellow : k == "lead" ? blue : k == "speed" ? red : accent), 0.5) }
      }
    }
  }

  component Athlete(a, showScore = true) {
    Row {
      gap: 6
      align: center
      Text { text: a.rank; width: 18; style: small; align: end; bold: a.rank <= 3; color: a.rank == 1 ? yellow : a.rank == 2 ? foreground : a.rank == 3 ? orange : muted }
      Flag { code: a.country }
      Text { text: a.name; style: small; weight: 1; maxLines: 1 }
      if showScore {
        Text { text: a.score ?? ""; style: small; width: 64; align: end; color: muted; maxLines: 1 }
      }
    }
  }

  // One category's winner on the tile.
  component Winner(c) {
    let w = c.top[0]
    Row {
      gap: 6
      align: center
      Text { text: c.short; style: small; width: wide ? 72 : 60; color: (c.kind == "boulder" ? yellow : c.kind == "lead" ? blue : c.kind == "speed" ? red : accent); maxLines: 1 }
      Flag { code: w.country }
      Text { text: w.name; style: small; weight: 1; maxLines: 1 }
      if wide {
        Text {
          text: c.status == null ? "${w.score} pts" : c.status == "finished" ? (w.score ?? "") : (c.round ?? "live")
          style: small; width: 72; align: end; color: c.status == null || c.status == "finished" ? muted : accent; maxLines: 1
        }
      }
    }
  }

  component EventRow(e) {
    Row {
      gap: 8
      align: center
      Box { width: 3; height: 30; radius: 1.5; background: e.state == "live" ? accent : e.state == "next" ? alpha(foreground, 0.6) : alpha(muted, 0.4) }
      Column {
        gap: 0
        weight: 1
        Text { text: e.name; style: body; maxLines: 1; color: e.state == "done" ? muted : foreground }
        Text { text: e.dates; style: small; color: muted; maxLines: 1 }
      }
      Kinds { list: e.kinds }
      if e.state == "next" {
        Until { t: e.start }
      } else {
        Text { text: e.state == "live" ? "live" : "✓"; style: small; width: 64; align: end; color: e.state == "live" ? accent : muted }
      }
    }
  }

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "IFSC World Cup"; style: title; weight: 1; maxLines: 1 }
      Text { text: live ? "● live" : season ?? ""; style: small; width: 60; align: end; color: live ? accent : muted; bold: live }
    }

    // The next event (or the live one) up top.
    if live {
      Row {
        gap: 8; align: center
        Text { text: latest.name; style: body; weight: 1; maxLines: 1; color: accent }
        Kinds { list: latest.kinds }
      }
    } else if next != null {
      Row {
        gap: 8; align: center
        Column {
          gap: 0; weight: 1
          Text { text: "next · ${next.name}"; style: body; maxLines: 1 }
          Text { text: next.dates; style: small; color: muted; maxLines: 1 }
        }
        if wide { Kinds { list: next.kinds } }
        Until { t: next.start; tint: accent; fs: 15 }
      }
    } else if sea != null {
      Text { text: "season over"; style: small; color: muted }
    }

    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }

    if latest != null {
      Text { text: "${live ? "now" : "last"} · ${latest.name}"; style: label; color: muted; maxLines: 1 }
      Column {
        gap: 3
        for c in shown { Winner { c: c } }
      }
      if count(leaders) > 0 {
        Spacer { height: 4 }
        Text { text: "cup leaders"; style: label; color: muted; maxLines: 1 }
        Column {
          gap: 3
          for c in leaders { Winner { c: c } }
        }
      }
    } else {
      Text { text: sea == null ? "loading…" : "no results yet"; style: small; color: muted }
    }
  }

  screen {
    title: "IFSC World Cup ${season ?? ''}"
    Column {
      gap: 10
      Row {
        gap: 6
        Button { text: live ? "live" : "results"; weight: 1; color: tab == "results" ? accent : muted; onTap: tab = "results" }
        Button { text: "standings"; weight: 1; color: tab == "cup" ? accent : muted; onTap: { tab = "cup"; pick = 0 } }
        Button { text: "calendar"; weight: 1; color: tab == "calendar" ? accent : muted; onTap: tab = "calendar" }
      }

      Column {
        weight: 1
        scroll: true
        onPull: refresh()
        gap: 6

        if tab == "results" {
          if latest == null {
            Text { text: "no results yet"; style: small; color: muted }
          } else {
            Text { text: latest.full; style: title; maxLines: 2 }
            Row {
              gap: 8; align: center
              Text { text: latest.dates; style: small; color: muted; weight: 1 }
              if live { Text { text: "● live"; style: small; color: accent; bold: true; width: 60; align: end } }
            }
            for c in results {
              Spacer { height: 6 }
              Row {
                align: center
                Text { text: lower(c.name); style: label; color: (c.kind == "boulder" ? yellow : c.kind == "lead" ? blue : c.kind == "speed" ? red : accent); weight: 1 }
                Text { text: c.status == "finished" ? "final" : (c.round ?? c.status); style: small; color: c.status == "finished" ? muted : accent; width: 110; align: end; maxLines: 1 }
              }
              for a in c.top key a.name { Athlete { a: a } }
            }
            Spacer { height: 6 }
            Button { text: "full results on ifsc.results.info"; onTap: url("https://ifsc.results.info/event/${latest.id}") }
          }
        } else if tab == "cup" {
          Flow {
            gap: 6
            for s, i in standings {
              Button { text: s.short; color: pick == i ? (s.kind == "boulder" ? yellow : s.kind == "lead" ? blue : s.kind == "speed" ? red : accent) : muted; onTap: pick = i }
            }
          }
          let s = standings[pick]
          if s == null {
            Text { text: cupInfo == null ? "loading…" : "no standings yet"; style: small; color: muted }
          } else {
            Text { text: lower(s.name); style: title; color: (s.kind == "boulder" ? yellow : s.kind == "lead" ? blue : s.kind == "speed" ? red : accent) }
            for a in s.top key a.name { Athlete { a: a } }
          }
        } else {
          for e in events key e.id { EventRow { e: e } }
        }
      }

      Button { text: "close"; onTap: close() }
    }
  }
}
