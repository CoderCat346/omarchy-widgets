widget "xkcd" {
  meta { description: "The latest xkcd comic with its title and alt text; tap to open it"; version: "1.2"; license: "MIT"; category: "fun"; owl: 16 }
  size: 6x5
  minSize: 3x3



  // The image comes by URL; the launcher keeps it, so it shows offline too.
  source comic = http("https://xkcd.com/info.0.json") every 1h json timeout 20s
  let img = last(split(comic.img ?? "", "/"))

  onTap: url("https://xkcd.com/${comic.num}")

  Column {
    gap: 4
    Row {
      Text { text: comic.safe_title; style: body; bold: true; maxLines: 1; weight: 1 }
      Text { text: "#${comic.num}"; style: muted; width: 56; align: end }
    }
    if img { Image { src: "https://imgs.xkcd.com/comics/${enc(img)}"; fit: contain; fill: width; weight: 1 } }
    Text { text: comic.alt; style: small; color: muted; maxLines: 3 }
  }
}
