widget "picture of the day" {
  meta { description: "Wikimedia Commons' picture of the day with its caption; tap to see the full image"; version: "1.2"; license: "MIT"; category: "fun"; owl: 16 }
  size: 6x4
  minSize: 3x3
  padding: 0



  // Wikimedia's featured feed for today (UTC); the picture comes by URL, and the launcher keeps it.
  source now = clock every 1h
  source feed = http("https://api.wikimedia.org/feed/v1/wikipedia/en/featured/${enc(fmtTime(now, "yyyy", "UTC"))}/${enc(fmtTime(now, "MM", "UTC"))}/${enc(fmtTime(now, "dd", "UTC"))}") every 1h json timeout 30s
  let im = feed.image
  let pic = im == null ? null : {
    // Thumbnails come from thumb.wikimedia.org, older ones from upload.wikimedia.org.
    thumb: startsWith(im.thumbnail.source ?? "", "https://thumb.wikimedia.org/") ? sub(im.thumbnail.source, 28) : null,
    path: startsWith(im.thumbnail.source ?? "", "https://upload.wikimedia.org/") ? sub(im.thumbnail.source, 29) : null,
    url: im.file_page,
    caption: join(split(im.description.text ?? (match(im.title ?? "", "^(?:File:)?(.*?)(?:[.][A-Za-z]+)?$")[0] ?? ""), "<").map(t => last(split(t, ">"))), ""),
    artist: join(split(im.artist.text ?? "", "<").map(t => last(split(t, ">"))), "")
  }

  onTap: url(pic.url ?? "https://commons.wikimedia.org/wiki/Commons:Picture_of_the_day")

  Box {
    fill: true
    align: bottom
    if pic.thumb != null { Image { src: "https://thumb.wikimedia.org/${pic.thumb}"; fit: cover; fill: true } }
    else if pic.path != null { Image { src: "https://upload.wikimedia.org/${pic.path}"; fit: cover; fill: true } }
    Column {
      fill: width
      gap: 0
      padding: [10, 6]
      background: alpha(background, 0.75)
      Text { text: pic.caption; fontSize: 12; maxLines: 2 }
      if pic.artist != "" && pic.artist != null { Text { text: pic.artist; fontSize: 10; color: muted; maxLines: 1 } }
    }
  }
}
