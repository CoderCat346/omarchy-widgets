// A theme-aware command deck above a Dragon-style nest: drag from the centre to launch.
// Based on druspect's Hex Command (faces/druspect/hex-command), the original face.
face "hex nest" {
  page: 0
  statusBar: false
  padding: 0

  meta {
    owl: 22
    description: "A theme-aware command deck above a Dragon-style hex nest: drag to launch, switch modes to zoom and pan. Based on druspect's Hex Command."
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  source bat = android.battery
  source notes = android.notifications
  source drawer = android.drawer
  source dev = android.device
  source sys = android.system every 5s
  // wttr.in supplies weather for the network's approximate location, so the
  // shared face contains no personal coordinates or location settings.
  source wx = http("https://wttr.in/?format=j1") every 30m timeout 10s json

  state zoom = 1
  state panX = 0
  state panY = 0
  state dragX = 0
  state dragY = 0
  state dragging = false
  state selectedKey = null
  state pressX = 0
  state pressY = 0
  state dragged = false
  state launchMode = true
  state deckCollapsed = false
  state touchCount = 0
  state prevPinchDist = 0
  state prevPinchX = 0
  state prevPinchY = 0

  // Dragon-style nests: apps placed on concentric rings; launch by dragging
  // from the centre toward a point (release to open). Three nests: 6, 12, 18.
  let ringCounts = [6, 12, 18]
  let ringOffsets = [0, 15, 7.5]
  let cells = flatten(range(3).map(k =>
    range(ringCounts[k]).map(i => ({a: ringOffsets[k] + i * 360 / ringCounts[k], ring: k}))
  ))

  // Keep launchers/runtime helpers and privacy-sensitive finance apps in the
  // drawer, not on the glanceable face. Match name, alias and key/package so
  // this also catches generically named or Linux .desktop entries.
  let privateTerms = [
    " bank", "bank ", "banking", "credit one", "creditone", "capital one", "capitalone",
    "chase", "wells fargo", "wellsfargo", "citibank", "citi mobile", "paypal", "venmo",
    "cash app", "cashapp", "discover mobile", "ally mobile", "american express", "amex"
  ]
  let runtimeTerms = ["openjdk", " jdk", "jdk ", "java development kit", "java runtime", "jconsole", "jshell"]
  let visibleApps = (drawer.apps ?? []).filter(a => {
    hay: " " + lower("${a.name} ${a.alias ?? ""} ${a.key ?? ""}"),
    hide: any(privateTerms, t => contains(" " + lower("${a.name} ${a.alias ?? ""} ${a.key ?? ""}"), t)) || any(runtimeTerms, t => contains(" " + lower("${a.name} ${a.alias ?? ""} ${a.key ?? ""}"), t))
  }.hide == false)
  // Drawer score is Omalauncher's decaying usage score. De-duplicate copies with
  // the same visible name after filtering, so the best-used copy wins its position.
  let ranked = values(groupBy(visibleApps.sortBy(a => -(a.score ?? 0)), a => a.name)).map(g => g[0]).take(len(cells))
  let hex = min(43, max(35, (tileWidth ?? 400) / 9.2))
  let ringRadii = [hex * 3.0, hex * 5.8, hex * 8.6]
  let cancelR = hex * 1.5
  let maxDrag = hex * 9.5
  let fieldDrop = 0
  let mapped = range(min(len(ranked), len(cells))).map(i => {
    app: ranked[i],
    ring: cells[i].ring,
    angle: cells[i].a,
    px: ringRadii[cells[i].ring] * cos(rad(cells[i].a)),
    py: ringRadii[cells[i].ring] * sin(rad(cells[i].a))
  })
  let placed = mapped.map(p => merge(p, {px: p.px, py: p.py + fieldDrop}))
  let nearest = null
  let usableHeight = (tileHeight ?? 800) - screenInset
  let infoHeight = usableHeight * 0.25
  // Centre of the AppField as the touch handlers see it, for hit-testing.
  let deckBarH = 22
  let fieldH = (tileHeight ?? 800) - screenInset - deckBarH - (deckCollapsed ? 0 : infoHeight)
  let fieldCX = (tileWidth ?? 400) / 2
  let fieldCY = fieldH / 2
  let cur = wx == null ? null : first(wx.current_condition)
  let day = wx == null ? null : first(wx.weather)
  let curCode = cur == null ? "113" : str(cur.weatherCode)
  let weatherIconNow = curCode
  let weatherName = cur == null || first(cur.weatherDesc) == null ? "—" : lower(trim(first(cur.weatherDesc).value))
  let memPct = round((sys.memory.used ?? 0) / (sys.memory.total ?? 1) * 100)
  let diskPct = round(((sys.storage.total ?? 1) - (sys.storage.free ?? 0)) / (sys.storage.total ?? 1) * 100)
  let todayHigh = day == null ? null : num(day.maxtempF)
  let todayLow = day == null ? null : num(day.mintempF)
  let deckState = bat.level < 20 || memPct > 90 || diskPct > 94 ? "ATTENTION" : "NOMINAL"
  let deckColor = deckState == "NOMINAL" ? green : orange

  background: transparent

  component TinyMetric(label, value, tint = foreground) {
    Column {
      weight: 1
      gap: 0
      Text { text: upper(label); font: sans; fontSize: 6; fontWeight: 650; letterSpacing: 0.4; color: muted; maxLines: 1 }
      Text { text: value; font: sans; fontSize: 9; fontWeight: 700; color: tint; maxLines: 1 }
    }
  }

  component StatTile(label, value, amount = null, tint = accent) {
    Box {
      fill: true
      background: linear(0, 0, 1, 1, [alpha(surface, 0.58), alpha(background, 0.28)])
      border: 1
      borderColor: alpha(tint, 0.24)
      radius: 6 * corners
      Column {
        fill: true
        gap: 1
        padding: [7, 4]
        Row {
          fill: width
          align: center
          Text { text: upper(label); font: sans; fontSize: 6; fontWeight: 650; letterSpacing: 0.35; color: muted; maxLines: 1; weight: 1 }
          Box { size: 3; radius: 2; background: tint }
        }
        Text { text: value; font: sans; fontSize: 10; fontWeight: 750; color: foreground; maxLines: 1 }
        Spacer { weight: 1 }
        Progress { visible: amount != null; value: amount ?? 0; height: 2; color: tint; track: alpha(foreground, 0.07) }
      }
    }
  }

  component StatusTile(label, value, tint = muted) {
    Box {
      fill: true
      background: alpha(surface, 0.4)
      border: 1
      borderColor: alpha(tint, 0.18)
      radius: 5 * corners
      Row {
        fill: true
        align: center
        gap: 4
        padding: [7, 3]
        Text { text: upper(label); font: sans; fontSize: 6; fontWeight: 650; letterSpacing: 0.35; color: muted; maxLines: 1 }
        Text { text: value; font: sans; fontSize: 8; fontWeight: 750; color: tint; maxLines: 1; weight: 1; align: end }
      }
    }
  }

  component CommandCenter() {
    Box {
      fill: true
      padding: [8, 7, 8, 6]
      frost: 18
      background: linear(0, 0, 1, 1, [alpha(surface, 0.66), alpha(accent, 0.09), alpha(background, 0.36)])
      border: 1
      borderColor: alpha(accent, 0.26)
      radius: 10 * corners
      Row {
        fill: true
        gap: 0
        Box {
          width: 3
          fill: height
          background: linear(0, 0, 0, 1, [alpha(accent, 0.28), accent, alpha(accent, 0.28)])
          radius: 2
        }
        Column {
          weight: 1
          fill: height
          gap: 5
          padding: [8, 6]

          Row {
            fill: width
            height: 25
            align: center
            gap: 7
            Column {
              weight: 1
              gap: 0
              Text { text: upper(sys.theme ?? "OMARCHY"); font: sans; fontSize: 10; fontWeight: 800; letterSpacing: 0.7; color: accent; maxLines: 1 }
              Text { text: "COMMAND DECK  /  ${upper(dev.model ?? "ANDROID")}"; font: sans; fontSize: 6; fontWeight: 600; letterSpacing: 0.45; color: muted; maxLines: 1 }
            }
            Row {
              align: center
              gap: 4
              padding: [7, 3]
              background: alpha(deckColor, 0.09)
              border: 1
              borderColor: alpha(deckColor, 0.3)
              radius: 5 * corners
              Box { size: 4; radius: 2; background: deckColor }
              Text { text: deckState; font: sans; fontSize: 6; fontWeight: 800; letterSpacing: 0.4; color: deckColor }
            }
          }

          Row {
            fill: width
            weight: 1
            gap: 6
            Box {
              width: (tileWidth ?? 400) * 0.31
              fill: height
              background: linear(0, 0, 1, 1, [alpha(accent, 0.11), alpha(surface, 0.48)])
              border: 1
              borderColor: alpha(accent, 0.26)
              radius: 7 * corners
              Column {
                fill: true
                gap: 3
                padding: [8, 5]
                Text { text: "ENVIRONMENT"; font: sans; fontSize: 6; fontWeight: 750; letterSpacing: 0.55; color: accent }
                Row {
                  fill: width
                  align: center
                  gap: 6
                  Text { text: weatherIcon(weatherIconNow, false); font: icon; fontSize: 22; color: contains(["113", "116"], curCode) ? yellow : foreground; width: 25; align: center }
                  Column {
                    weight: 1
                    gap: 0
                    Text { text: cur == null ? "—" : "${cur.temp_F}°"; font: sans; fontSize: 22; fontWeight: 550; maxLines: 1 }
                    Text { text: weatherName; font: sans; fontSize: 7; fontWeight: 600; color: muted; maxLines: 1 }
                  }
                }
                Spacer { weight: 1 }
                Row {
                  fill: width
                  gap: 4
                  TinyMetric { label: "Range"; value: todayHigh == null || todayLow == null ? "—" : "${round(todayLow)}–${round(todayHigh)}°" }
                  TinyMetric { label: "Wind"; value: cur == null ? "—" : "${cur.windspeedMiles} mph" }
                }
              }
            }

            Column {
              weight: 1
              fill: height
              gap: 4
              Row {
                fill: width
                height: 17
                align: center
                Column {
                  weight: 1
                  gap: 0
                  Text { text: "DEVICE CORE"; font: sans; fontSize: 7; fontWeight: 800; letterSpacing: 0.55; color: foreground }
                  Text { text: "${sys.cpu.soc ?? sys.cpu.hardware}  /  UP ${sys.uptime == null ? "—" : fmtDuration(sys.uptime)}"; font: sans; fontSize: 6; color: muted; maxLines: 1 }
                }
                Text { text: "A${dev.android ?? "—"}"; font: sans; fontSize: 7; fontWeight: 750; color: accent }
              }
              Row {
                fill: width
                weight: 1
                gap: 4
                StatTile { label: "Memory"; value: "${memPct}%"; amount: memPct; tint: memPct > 85 ? red : accent; weight: 1; fill: height }
                StatTile { label: "Storage"; value: "${diskPct}%"; amount: diskPct; tint: diskPct > 90 ? red : cyan; weight: 1; fill: height }
                StatTile { label: "Battery"; value: "${bat.level}%"; amount: bat.level; tint: bat.level < 20 ? red : green; weight: 1; fill: height }
              }
              Row {
                fill: width
                weight: 1
                gap: 4
                StatTile { label: "CPU"; value: sys.cpu == null ? "—" : "${sys.cpu.cores} core"; weight: 1; fill: height }
                StatTile { label: "Display"; value: sys.display == null ? "—" : "${round(sys.display.hz)} Hz"; tint: cyan; weight: 1; fill: height }
                StatTile { label: "Thermal"; value: bat.temp == null ? "—" : "${fixed(bat.temp, 1)}°C"; tint: bat.temp > 42 ? red : green; weight: 1; fill: height }
              }
            }
          }

          Row {
            fill: width
            height: 23
            gap: 4
            StatusTile { label: "Humidity"; value: cur == null ? "—" : "${cur.humidity}%"; tint: cyan; weight: 1; fill: height }
            StatusTile { label: "Feels"; value: cur == null ? "—" : "${cur.FeelsLikeF}°"; tint: foreground; weight: 1; fill: height }
            StatusTile { label: "Notices"; value: notes.available ? str(notes.count) : "—"; tint: notes.available && notes.count > 0 ? accent : muted; weight: 1; fill: height }
            StatusTile { label: "Updates"; value: str(drawer.updates ?? 0); tint: (drawer.updates ?? 0) > 0 ? accent : muted; weight: 1; fill: height }
          }
        }
      }
    }
  }

  component NestPoint(p) {
    let selected = dragging && selectedKey == p.app.key
    Box {
      width: hex * 1.5
      height: hex * 1.5
      offset: [p.px * zoom + panX, p.py * zoom + panY]
      scale: selected ? 1.28 : 1
      opacity: dragging && selectedKey != null && selectedKey != p.app.key ? 0.42 : 1
      align: center
      animate scale: spring(0.28, 210)
      animate opacity: tween(80ms, "ease")
      Box {
        fill: true
        radius: hex * 0.75
        background: alpha(surface, selected ? 0.96 : 0.84)
        border: selected ? 2.5 : 1
        borderColor: selected ? accent : alpha(foreground, 0.2)
        align: center
        if p.app.hasIcon {
          Image {
            src: p.app.icon
            size: hex * 0.86
            tint: drawer.monochrome ? accent : null
            label: p.app.label
          }
        } else {
          Text { text: p.app.initials; font: mono; fontSize: hex * 0.34; color: accent; bold: true }
        }
      }
    }
  }

  component AppField() {
    Box {
      fill: true
      clip: true

      // Nest rings and drag visuals (with zoom/pan).
      Canvas {
        let gx = width / 2 + panX
        let gy = height / 2 + panY
        let r0 = ringRadii[0] * zoom
        let r1 = ringRadii[1] * zoom
        let r2 = ringRadii[2] * zoom
        let cr = cancelR * zoom
        let hexPts = range(6).map(i => [gx + r0 * cos(rad(i * 60)), gy + r0 * sin(rad(i * 60))])
        path(hexPts, closed: true, stroke: alpha(accent, 0.35), width: 1.5)
        circle(gx, gy, r1, stroke: alpha(foreground, 0.07), width: 1)
        circle(gx, gy, r2, stroke: alpha(foreground, 0.07), width: 1)
        circle(gx, gy, cr, fill: alpha(foreground, 0.05), stroke: alpha(foreground, 0.18), width: 1)
        if dragging {
          let fx = width / 2 + dragX
          let fy = height / 2 + dragY
          line(gx, gy, fx, fy, stroke: accent, width: 2, cap: round)
          circle(fx, fy, 5, fill: accent)
        }
      }

      Box {
        fill: true
        align: center
        for p in placed key p.app.key {
          NestPoint { p: p }
        }
      }

      Box {
        fill: true
        align: top
        Column {
          fill: width
          align: center
          padding: [0, 8]
          gap: 2
          Text { text: "DRAGON NEST  /  GESTURE LAUNCH"; font: mono; fontSize: 9; color: muted; letterSpacing: 1.4; align: center; fill: width }
          Text { text: dragging && selectedKey != null ? upper(first(placed.filter(p => p.app.key == selectedKey)).app.name ?? "") : (selectedKey == null && dragging ? "CANCEL" : "DRAG TO AN APP"); font: mono; fontSize: 12; color: accent; maxLines: 1; align: center; fill: width }
        }
      }
      Box {
        fill: true
        align: bottom
        Text {
          text: "DRAG FROM CENTRE  ·  RELEASE TO LAUNCH"
          align: center
          font: mono
          fontSize: 8
          color: alpha(muted, 0.65)
          letterSpacing: 1.2
          fill: width
          padding: [0, 0, 0, 8]
        }
      }

      // One full-field touch surface on top: taps pick an app and nothing is
      // swallowed by the icon nodes underneath. The deck picks the drag mode.
      if launchMode {
        Box {
          fill: true
          background: alpha(foreground, 0.001)
          onPress: { dragged = false }
          onTap: {
            if dragged {
              dragged = false
            } else {
              let tx = (x - fieldCX - panX) / zoom
              let ty = (y - fieldCY - panY) / zoom
              let hit = first(placed.sortBy(p => (p.px - tx) * (p.px - tx) + (p.py - ty) * (p.py - ty)))
              if hit != null {
                let d = sqrt((hit.px - tx) * (hit.px - tx) + (hit.py - ty) * (hit.py - ty))
                if d < hex * 0.95 { haptic(); open(hit.app.key) }
              }
            }
          }
          onDrag: {
            dragX = clamp(x - fieldCX, -maxDrag, maxDrag)
            dragY = clamp(y - fieldCY, -maxDrag, maxDrag)
            dragging = true
            let gx = (dragX - panX) / zoom
            let gy = (dragY - panY) / zoom
            let gd = sqrt(gx * gx + gy * gy)
            if gd < cancelR {
              selectedKey = null
            } else {
              let nearApp = first(placed.sortBy(p => (p.px - gx) * (p.px - gx) + (p.py - gy) * (p.py - gy)))
              selectedKey = nearApp == null ? null : nearApp.app.key
            }
            dragged = true
          }
          onDragEnd: {
            if selectedKey != null { open(selectedKey) }
            dragX = 0
            dragY = 0
            dragging = false
            selectedKey = null
            dragged = true
            haptic()
          }
        }
      } else {
        Box {
          fill: true
          background: alpha(foreground, 0.001)
          onPress: { dragged = false }
          onTap: {
            if dragged {
              dragged = false
            } else {
              let tx = (x - fieldCX - panX) / zoom
              let ty = (y - fieldCY - panY) / zoom
              let hit = first(placed.sortBy(p => (p.px - tx) * (p.px - tx) + (p.py - ty) * (p.py - ty)))
              if hit != null {
                let d = sqrt((hit.px - tx) * (hit.px - tx) + (hit.py - ty) * (hit.py - ty))
                if d < hex * 0.95 { haptic(); open(hit.app.key) }
              }
            }
          }
          // One finger pans the nest while in view mode.
          onDrag: {
            panX = clamp(panX + dx, -hex * 8 * zoom, hex * 8 * zoom)
            panY = clamp(panY + dy, -hex * 8 * zoom, hex * 8 * zoom)
            dragging = false
            selectedKey = null
            dragged = true
          }
          onDragEnd: { dragged = true; haptic() }
          // Two fingers pinch to zoom and move the nest.
          onTouch: {
            if len(touches) == 2 {
              let a = touches[0]
              let b = touches[1]
              let dx2 = b.x - a.x
              let dy2 = b.y - a.y
              let dist = sqrt(dx2 * dx2 + dy2 * dy2)
              let mx = (a.x + b.x) / 2
              let my = (a.y + b.y) / 2
              if prevPinchDist == 0 {
                prevPinchDist = dist
                prevPinchX = mx
                prevPinchY = my
              } else {
                if prevPinchDist > 0 { zoom = clamp(zoom * dist / prevPinchDist, 0.5, 3) }
                panX = clamp(panX + (mx - prevPinchX), -hex * 8 * zoom, hex * 8 * zoom)
                panY = clamp(panY + (my - prevPinchY), -hex * 8 * zoom, hex * 8 * zoom)
                prevPinchDist = dist
                prevPinchX = mx
                prevPinchY = my
              }
              dragged = true
              dragging = false
              selectedKey = null
              dragX = 0
              dragY = 0
            } else {
              prevPinchDist = 0
            }
          }
        }
      }
    }
  }

  Box {
    fill: true
    // One full-face Adreno effect: theme-colored shadows lick inward from the
    // bezel while the center remains clear and the wallpaper stays visible.
    Shader {
      fill: true
      fallback: transparent
      uniforms: { shadow: background, energy: accent }
      code: """
        uniform half4 shadow;
        uniform half4 energy;

        half4 main(float2 p) {
          float2 uv = p / size;

          // Several incommensurate signals keep the silhouette alive without
          // sending waves through the center of the screen.
          float ly = 0.5 + 0.5 * sin(uv.y * 31.0 + time * 1.8 + sin(uv.y * 73.0 - time * 0.9));
          float ry = 0.5 + 0.5 * sin(uv.y * 27.0 - time * 1.55 + sin(uv.y * 61.0 + time * 0.75));
          float tx = 0.5 + 0.5 * sin(uv.x * 35.0 - time * 1.4 + sin(uv.x * 79.0 + time * 0.7));
          float bx = 0.5 + 0.5 * sin(uv.x * 29.0 + time * 1.65 + sin(uv.x * 67.0 - time * 0.8));

          float ld = 0.018 + 0.058 * ly * ly * ly;
          float rd = 0.018 + 0.058 * ry * ry * ry;
          float td = 0.012 + 0.04 * tx * tx * tx;
          float bd = 0.015 + 0.05 * bx * bx * bx;

          float left = 1.0 - smoothstep(ld, ld + 0.035, uv.x);
          float right = 1.0 - smoothstep(rd, rd + 0.035, 1.0 - uv.x);
          float top = 1.0 - smoothstep(td, td + 0.025, uv.y);
          float bottom = 1.0 - smoothstep(bd, bd + 0.03, 1.0 - uv.y);
          float shade = max(max(left, right), max(top, bottom));

          float shimmer = 0.68 + 0.2 * sin(time * 3.2 + uv.y * 17.0) + 0.12 * sin(time * 5.1 - uv.x * 13.0);
          float rim = max(max(
            smoothstep(ld + 0.028, ld, uv.x) * smoothstep(ld - 0.006, ld + 0.008, uv.x),
            smoothstep(rd + 0.028, rd, 1.0 - uv.x) * smoothstep(rd - 0.006, rd + 0.008, 1.0 - uv.x)), max(
            smoothstep(td + 0.02, td, uv.y) * smoothstep(td - 0.005, td + 0.006, uv.y),
            smoothstep(bd + 0.024, bd, 1.0 - uv.y) * smoothstep(bd - 0.005, bd + 0.007, 1.0 - uv.y)));

          half3 col = mix(shadow.rgb, energy.rgb, rim * 0.22);
          float opacity = clamp(shade * shimmer * 0.14 + rim * 0.055, 0.0, 0.18);
          // RuntimeShader output is premultiplied: keeping RGB under alpha
          // prevents the rim from blowing out to white over pale wallpapers.
          return half4(col * opacity, opacity);
        }
      """
    }
    Column {
      fill: true
      gap: 0
      Row {
        fill: width
        padding: [4, 6]
        align: center
        Text { text: deckCollapsed ? "▸ COMMAND DECK" : "▾ COMMAND DECK"; font: mono; fontSize: 8; color: muted; letterSpacing: 1.2; onTap: deckCollapsed = !deckCollapsed }
        Spacer { weight: 1 }
        Text { text: launchMode ? "  1F LAUNCH  " : "  2F VIEW  "; font: mono; fontSize: 8; color: launchMode ? accent : cyan; onTap: { launchMode = !launchMode; dragX = 0; dragY = 0; dragging = false; selectedKey = null } }
        Text { text: "${round(zoom * 100)}%"; font: mono; fontSize: 8; color: muted }
        Text { text: "  −  "; font: mono; fontSize: 9; color: accent; onTap: zoom = clamp(zoom - 0.2, 0.5, 3) }
        Text { text: "  +  "; font: mono; fontSize: 9; color: accent; onTap: zoom = clamp(zoom + 0.2, 0.5, 3) }
        Text { text: "  reset  "; font: mono; fontSize: 8; color: muted; onTap: { zoom = 1; panX = 0; panY = 0 } }
      }
      if !deckCollapsed {
        CommandCenter { height: infoHeight }
      }
      AppField { weight: 1; fill: width }
      Spacer { height: screenInset }
    }
  }
}
